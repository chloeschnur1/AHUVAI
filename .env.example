# Copy to .env for local development. On a hosting service, enter these as
# environment variables instead (never commit real values).

# PostgreSQL connection
DATABASE_URL=postgres://ahuvai:password@localhost:5432/ahuvai
# require | no-verify | off   (production default: require)
DATABASE_SSL=off

# 32-byte key that encrypts questionnaire answers. Generate with: npm run generate-key
# Keep a copy in a password manager. If it is lost, saved profiles cannot be read.
DATA_ENCRYPTION_KEY=

# One-time code for creating the first administrator at /admin
ADMIN_SETUP_TOKEN=

# The address families use, e.g. https://portal.ahuvai.com (must be https in production)
PUBLIC_URL=http://localhost:3000
PORT=3000

# Optional: shown on the Contact page
CONTACT_EMAIL=

# Optional email (any SMTP provider: Google Workspace, Postmark, Resend, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AHUVAI <concierge@ahuvai.com>"
# Receives a short "new inquiry / new submission" alert (no family details)
OWNER_NOTIFICATION_EMAIL=

# Months before archived/inactive records are listed for deletion review
RETENTION_MONTHS=24
